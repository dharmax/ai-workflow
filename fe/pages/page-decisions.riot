<page-decisions>
  <div if={ !(props.decisions && props.decisions.length) } style="color:var(--text-muted); padding:16px;">No ADR decisions recorded.</div>
  <div class="tree-node" each={ d in (props.decisions || []) }>
    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
      <h4>📜 { d.id }: { d.title }</h4>
      <span class="pill" style={ d.status === 'accepted' ? 'color:#4ade80;' : d.status === 'proposed' ? 'color:#fbbf24;' : 'color:#f87171;' }>{ d.status }</span>
    </div>
    <p style="font-size:13px; color:var(--text); margin-top:8px; line-height:1.4;">{ d.body || 'No ADR body recorded.' }</p>
  </div>

  <script>
    export default {}
  </script>
</page-decisions>
