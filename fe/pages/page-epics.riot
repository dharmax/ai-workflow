<page-epics>
  <div if={ !(props.epics && props.epics.length) } style="color:var(--text-muted); padding:16px;">No Epics configured in epics.md.</div>
  <div class="tree-node" each={ e in (props.epics || []) }>
    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
      <div>
        <h4>📌 { e.id }: { e.title }</h4>
        <p style="font-size:13px; color:var(--text-muted); margin-top:4px;">{ e.body || 'No epic description.' }</p>
      </div>
      <span class="pill" style="color:var(--accent); font-weight:700;">{ getCompletion(e) }% Done</span>
    </div>
    <div class="tree-children">
      <strong>Linked Implementation Tickets ({ (e.children || []).length }):</strong>
      <div each={ c in (e.children || []) } style="font-size:12px; margin-top:6px; display:flex; justify-content:space-between;">
        <span>• <strong>{ c.id }</strong>: { c.title }</span>
        <span class="status-badge" style={ c.lane === 'Done' ? 'color:#4ade80;' : c.lane === 'In Progress' ? 'color:#38bdf8;' : 'color:#fbbf24;' }>{ c.lane || 'Todo' }</span>
      </div>
      <div if={ !(e.children && e.children.length) } style="font-size:12px; color:#64748b; margin-top:4px;">No linked tickets</div>
    </div>
  </div>

  <script>
    export default {
      getCompletion(e) {
        const children = e.children || [];
        if (children.length === 0) return 100;
        const done = children.filter(c => c.lane === 'Done');
        return Math.round((done.length / children.length) * 100);
      }
    }
  </script>
</page-epics>
