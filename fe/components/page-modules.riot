<page-modules>
  <table class="data-table">
    <thead><tr><th>Subsystem / Module</th><th>Completion</th><th>AST Symbols</th><th>Bugs</th><th>Active Tickets</th></tr></thead>
    <tbody>
      <tr each={ m in ((props.health && props.health.modules) || []) }>
        <td><strong>{ m.name }</strong></td>
        <td><strong>{ m.completionPercent }%</strong></td>
        <td>{ m.symbolCount }</td>
        <td>
          <span if={ m.bugsCount > 0 } style="color:#f87171;">{ m.bugsCount } 🔴</span>
          <span if={ m.bugsCount === 0 } style="color:#4ade80;">0</span>
        </td>
        <td>{ (m.activeTickets || []).join(', ') || '-' }</td>
      </tr>
      <tr if={ !(props.health && props.health.modules && props.health.modules.length) }><td colspan="5">No modules indexed.</td></tr>
    </tbody>
  </table>

  <script>
    export default {}
  </script>
</page-modules>
