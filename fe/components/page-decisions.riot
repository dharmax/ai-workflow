<page-decisions>
  <table class="data-table">
    <thead><tr><th>ID</th><th>Title</th><th>Status</th><th>Date</th></tr></thead>
    <tbody>
      <tr each={ d in (props.decisions || []) }>
        <td><strong>{ d.id }</strong></td>
        <td>{ d.title }</td>
        <td><span class="pill" style="color:#38bdf8;">{ d.status || 'accepted' }</span></td>
        <td>{ d.createdAt || '-' }</td>
      </tr>
      <tr if={ !(props.decisions && props.decisions.length) }><td colspan="4">No ADRs recorded.</td></tr>
    </tbody>
  </table>

  <script>
    export default {}
  </script>
</page-decisions>
