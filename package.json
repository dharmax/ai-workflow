{
  "name": "ai-workflow",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "workspaces": [
    "aiwf-common-core",
    "aiwf-shell",
    "aiwf-skill",
    "aiwf-mcp"
  ],
  "description": "Composite GitHub install surface for ai-workflow shell, MCP, and optional skill bridge.",
  "bin": {
    "ai-workflow": "./cli/ai-workflow.mjs",
    "aiwf-mcp": "./cli/aiwf-mcp.mjs",
    "aiwf-skill": "./aiwf-skill/install-ai-workflow-skill.mjs"
  },
  "files": [
    "aiwf-common-core/core",
    "aiwf-common-core/shared",
    "aiwf-common-core/package.json",
    "aiwf-common-core/README.md",
    "aiwf-shell/cli",
    "aiwf-shell/dist",
    "aiwf-shell/runtime",
    "aiwf-shell/scripts",
    "aiwf-shell/templates",
    "aiwf-shell/package.json",
    "aiwf-shell/README.md",
    "aiwf-mcp/dist",
    "aiwf-mcp/server.ts",
    "aiwf-mcp/package.json",
    "aiwf-mcp/README.md",
    "aiwf-skill/install-ai-workflow-skill.mjs",
    "aiwf-skill/skills",
    "aiwf-skill/package.json",
    "aiwf-skill/README.md",
    "cli",
    "scripts/build-github-deps.mjs",
    "scripts/validate-package.mjs",
    "package-lock.json",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-github-deps.mjs && npm run build --workspace aiwf-common-core && npm run build --workspace aiwf-shell && npm run build --workspace aiwf-mcp && npm run build --workspace aiwf-skill && node scripts/validate-package.mjs .",
    "generate-docs": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/scripts/generate-manual-html-cli.ts",
    "install:gemini-skill": "node aiwf-skill/install-ai-workflow-skill.mjs --project . --force",
    "install:tools": "npm install -w aiwf-common-core -w aiwf-shell -w aiwf-mcp -w aiwf-skill",
    "lint": "eslint .",
    "pack:core": "npm pack --dry-run --workspace aiwf-common-core",
    "pack:mcp": "npm pack --dry-run --workspace aiwf-mcp",
    "pack:root": "npm pack --dry-run",
    "pack:shell": "npm pack --dry-run --workspace aiwf-shell",
    "pack:skill": "npm pack --dry-run --workspace aiwf-skill",
    "prepare": "npm run build",
    "release:check": "npm run build && npm run workflow:dogfood -- --json && npm run workflow:audit -- --json && npm run pack:root && npm run pack:core && npm run pack:shell && npm run pack:mcp && npm run pack:skill",
    "perfection-marathon": "node ./node_modules/tsx/dist/cli.mjs tests/perfection-marathon.ts",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test --test-concurrency=1 tests/*.test.ts",
    "test:fast": "node ./node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "workflow:audit": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/cli/ai-workflow.ts run audit",
    "workflow:dogfood": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/cli/ai-workflow.ts run dogfood",
    "workflow:guidance": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/scripts/ai-workflow/guidance-summary.ts",
    "workflow:guideline-audit": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/scripts/ai-workflow/guideline-audit.ts",
    "workflow:kanban": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/cli/ai-workflow.ts run kanban-ops",
    "workflow:review": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/scripts/ai-workflow/review-summary.ts",
    "workflow:ticket": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/scripts/ai-workflow/kanban-ticket.ts",
    "workflow:verify": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/scripts/ai-workflow/verification-summary.ts",
    "workflow:summary": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/cli/ai-workflow.ts run summary",
    "workflow:sync": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/cli/ai-workflow.ts run sync",
    "workflow:metrics": "node ./node_modules/tsx/dist/cli.mjs aiwf-shell/cli/ai-workflow.ts run metrics"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
