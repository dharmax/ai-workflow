{
  "name": "@dharmax/ai-workflow",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Autonomous Engineering OS and ai-workflow CLI for token-efficient JS/TS repository work.",
  "bin": {
    "ai-workflow": "./cli/ai-workflow.mjs"
  },
  "scripts": {
    "build": "echo 'No build step for CLI'",
    "generate-docs": "node scripts/generate-manual-html.mjs",
    "install:tools": "npm install -g .",
    "lint": "eslint .",
    "perfection-marathon": "node tests/perfection-marathon.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:fast": "node --test tests/*.test.mjs",
    "workflow:audit": "node scripts/ai-workflow/workflow-audit.mjs",
    "workflow:dogfood": "node scripts/ai-workflow/dogfood.mjs",
    "workflow:guidance": "node scripts/ai-workflow/guidance-summary.mjs",
    "workflow:guideline-audit": "node scripts/ai-workflow/guideline-audit.mjs",
    "workflow:kanban": "node scripts/ai-workflow/kanban.mjs",
    "workflow:review": "node scripts/ai-workflow/review-summary.mjs",
    "workflow:ticket": "node scripts/ai-workflow/kanban-ticket.mjs",
    "workflow:verify": "node scripts/ai-workflow/verification-summary.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@dharmax/codebase-parser": "file:../codebase-parser",
    "@dharmax/block-patcher": "file:../block-patcher",
    "@dharmax/goe-governance": "file:../goe-governance",
    "@dharmax/human2js": "file:../human2js",
    "@dharmax/llm-utils": "file:../llm-utils",
    "@dharmax/shell-proc-utils": "file:../shell-proc-utils"
  }
}
