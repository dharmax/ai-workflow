{
  "name": "@dharmax/ai-workflow",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Autonomous Engineering OS and ai-workflow CLI for token-efficient JS/TS repository work.",
  "bin": {
    "ai-workflow": "./cli/ai-workflow.ts"
  },
  "scripts": {
    "build": "echo 'No build step for CLI'",
    "generate-docs": "tsx scripts/generate-manual-html.ts",
    "install:gemini-skill": "tsx scripts/install-ai-workflow-skill.ts --project . --force",
    "install:tools": "npm install -g .",
    "lint": "eslint .",
    "perfection-marathon": "tsx tests/perfection-marathon.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:fast": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "workflow:audit": "tsx scripts/ai-workflow/workflow-audit.ts",
    "workflow:dogfood": "tsx scripts/ai-workflow/dogfood.ts",
    "workflow:guidance": "tsx scripts/ai-workflow/guidance-summary.ts",
    "workflow:guideline-audit": "tsx scripts/ai-workflow/guideline-audit.ts",
    "workflow:kanban": "tsx scripts/ai-workflow/kanban.ts",
    "workflow:review": "tsx scripts/ai-workflow/review-summary.ts",
    "workflow:ticket": "tsx scripts/ai-workflow/kanban-ticket.ts",
    "workflow:verify": "tsx scripts/ai-workflow/verification-summary.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@dharmax/codebase-parser": "github:dharmax/codebase-parser",
    "@dharmax/block-patcher": "github:dharmax/block-patcher",
    "@dharmax/text-compiler": "github:dharmax/text-compiler",
    "@dharmax/context-manager": "github:dharmax/context-manager",
    "@dharmax/llm-utils": "github:dharmax/llm-utils",
    "@dharmax/shell-proc-utils": "github:dharmax/shell-proc-utils"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "tsx": "^4.21.0"
  }
}
