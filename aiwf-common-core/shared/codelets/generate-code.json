{
  "id": "generate-code",
  "summary": "Generate a concrete graph-backed coding plan with target files, patch intent, guardrail checks, and verification steps.",
  "stability": "experimental",
  "category": "coding",
  "runner": "node-script",
  "entry": "aiwf-shell/scripts/ai-workflow/smart-codelet-runner.ts",
  "focus": "code generation, implementation planning, patch design, verification, and guardrail-aware coding",
  "taskClass": "feature-implementation",
  "inputSchema": {
    "type": "object",
    "required": ["goal"],
    "properties": {
      "ticketId": { "type": "string" },
      "filePath": { "type": "string" },
      "goal": { "type": "string" }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["summary", "files_to_change", "patch_plan", "guardrail_checks", "verification_steps"],
    "properties": {
      "summary": { "type": "string" },
      "files_to_change": { "type": "array" },
      "patch_plan": { "type": "array" },
      "guardrail_checks": { "type": "array" },
      "verification_steps": { "type": "array" }
    }
  },
  "contextPolicy": {
    "mode": "graph-backed-surgical",
    "include": ["ticket", "file", "symbols", "linkedTests", "guidelines", "activeGuardrails", "recentNotes"]
  },
  "toolPolicy": {
    "canWriteFiles": false,
    "canRunTests": false,
    "requiresEvidence": true,
    "requiresGuardrailChecks": true,
    "mutationRequiresExecuteTicket": true
  },
  "graderId": "code-generation-v1",
  "maxRetries": 2,
  "canMutate": false
}
