{
  "id": "guideline-enforcer",
  "summary": "Enforce coding, architecture, workflow, and plugin/shell guardrails against the current task context.",
  "stability": "experimental",
  "category": "governance",
  "runner": "node-script",
  "entry": "aiwf-shell/scripts/ai-workflow/smart-codelet-runner.ts",
  "focus": "guideline enforcement, architecture boundaries, coding standards, shell/plugin guardrails, and GoE compliance",
  "taskClass": "review",
  "inputSchema": {
    "type": "object",
    "required": ["goal"],
    "properties": {
      "ticketId": { "type": "string" },
      "filePath": { "type": "string" },
      "goal": { "type": "string" }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["summary", "enforced_guardrails", "violations", "required_actions", "verification_steps"],
    "properties": {
      "summary": { "type": "string" },
      "enforced_guardrails": { "type": "array" },
      "violations": { "type": "array" },
      "required_actions": { "type": "array" },
      "verification_steps": { "type": "array" }
    }
  },
  "contextPolicy": {
    "mode": "graph-backed-surgical",
    "include": ["ticket", "file", "symbols", "guidelines", "activeGuardrails", "recentNotes"]
  },
  "toolPolicy": {
    "canWriteFiles": false,
    "canRunTests": false,
    "requiresEvidence": true,
    "requiresGuardrailChecks": true
  },
  "graderId": "guideline-enforcement-v1",
  "maxRetries": 2,
  "canMutate": false
}
