{
  "id": "debug-code",
  "summary": "Debug code with graph-backed context, evidence, suspected root causes, and verification steps.",
  "stability": "experimental",
  "category": "debugging",
  "runner": "node-script",
  "entry": "aiwf-shell/scripts/ai-workflow/smart-codelet-runner.ts",
  "exec": "js",
  "focus": "code debugging, bug hunting, root-cause analysis, and verification planning",
  "taskClass": "bug-hunting",
  "inputSchema": {
    "type": "object",
    "required": ["goal"],
    "properties": {
      "ticketId": { "type": "string" },
      "filePath": { "type": "string" },
      "goal": { "type": "string" }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["summary", "observations", "suspected_root_causes", "suggested_actions", "verification_steps"],
    "properties": {
      "summary": { "type": "string" },
      "observations": { "type": "array" },
      "suspected_root_causes": { "type": "array" },
      "suggested_actions": { "type": "array" },
      "verification_steps": { "type": "array" }
    }
  },
  "contextPolicy": {
    "mode": "graph-backed-surgical",
    "include": ["ticket", "file", "symbols", "linkedTests", "guidelines", "recentNotes"]
  },
  "toolPolicy": {
    "canWriteFiles": false,
    "canRunTests": false,
    "requiresEvidence": true
  },
  "graderId": "debug-code-v1",
  "maxRetries": 2,
  "canMutate": false
}
