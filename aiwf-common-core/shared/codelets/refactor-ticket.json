{
  "id": "refactor-ticket",
  "summary": "Plan or execute a bounded refactor ticket with DB-backed ctx, guarded patching, and verification.",
  "stability": "experimental",
  "category": "refactoring",
  "runner": "node-script",
  "entry": "aiwf-shell/scripts/ai-workflow/execute-ticket.ts",
  "focus": "bounded refactor planning, implementation, code review, and verification",
  "taskClass": "feature-implementation",
  "inputSchema": {
    "type": "object",
    "required": ["ticketId"],
    "properties": {
      "ticketId": { "type": "string" },
      "apply": { "type": "boolean" },
      "timeoutMs": { "type": "number" },
      "mode": { "type": "string" },
      "root": { "type": "string" },
      "evidenceRoot": { "type": "string" },
      "allowExternalTarget": { "type": "boolean" }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["success", "ticketId", "verification", "runArtifact"],
    "properties": {
      "success": { "type": "boolean" },
      "ticketId": { "type": "string" },
      "verification": { "type": "object" },
      "runArtifact": { "type": "object" }
    }
  },
  "contextPolicy": {
    "mode": "graph-backed-surgical",
    "requiresTicket": true,
    "include": ["ticket", "workingSetEvidence", "guidelines", "verificationPlan"]
  },
  "toolPolicy": {
    "canWriteFiles": true,
    "requiresApplyFlag": true,
    "requiresSafeRepairTarget": true,
    "requiresVerification": true
  },
  "graderId": "ticket-execution-v1",
  "maxRetries": 1,
  "canMutate": true
}
