{
  "name": "aiwf-shell",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Interactive CLI, runtime wrappers, and operator tooling for ai-workflow.",
  "main": "./cli/index.ts",
  "bin": {
    "ai-workflow": "./dist/ai-workflow.mjs"
  },
  "exports": {
    ".": "./cli/index.ts",
    "./cli/*": "./cli/*.ts",
    "./cli/lib/*": "./cli/lib/*.ts",
    "./runtime/*": "./runtime/*",
    "./scripts/*": "./scripts/*",
    "./templates/*": "./templates/*"
  },
  "files": [
    "cli",
    "dist",
    "runtime",
    "scripts",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build-cli.mjs && node ../scripts/validate-package.mjs .",
    "typecheck": "node ../scripts/validate-package.mjs ."
  },
  "dependencies": {
    "aiwf-common-core": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
