{
  "name": "aiwf-shell",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Interactive CLI, runtime wrappers, and operator tooling for ai-workflow.",
  "main": "./cli/index.ts",
  "bin": {
    "ai-workflow": "./cli/ai-workflow.ts"
  },
  "exports": {
    ".": "./cli/index.ts",
    "./cli/*": "./cli/*.ts",
    "./cli/lib/*": "./cli/lib/*.ts",
    "./runtime/*": "./runtime/*",
    "./scripts/*": "./scripts/*",
    "./templates/*": "./templates/*"
  },
  "files": [
    "cli",
    "runtime",
    "scripts",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../scripts/validate-package.mjs .",
    "typecheck": "bun ../scripts/validate-package.mjs ."
  },
  "dependencies": {
    "aiwf-common-core": "0.1.0",
    "aiwf-mcp": "0.1.0"
  }
}
